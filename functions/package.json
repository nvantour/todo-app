{
  "name": "todo-app-functions",
  "private": true,
  "version": "0.1.0",
  "description": "Serverkant van de todo-app: REST-koppelpunt (api), MCP-server (mcp) en spraakroute.",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node build.mjs",
    "test": "vitest run",
    "serve": "npm run build && firebase emulators:start --only functions,firestore"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
