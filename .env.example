# Firebase-instellingen (Firebase-console → Projectinstellingen → Je apps → Web-app).
# Zonder deze waarden draait de app op lokale opslag met voorbeelddata en zonder inlogscherm.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Meldingen (pushberichten): Firebase-console, Projectinstellingen, Cloud Messaging, Web Push-certificaten, "Sleutelpaar genereren".
# Zonder deze sleutel staat de schakelaar Meldingen uit in Instellingen.
VITE_FIREBASE_VAPID_KEY=

# Alleen voor ontwikkeling (optioneel): werk tegen de lokale Firestore-emulator in plaats van de echte database.
# VITE_FIRESTORE_EMULATOR=localhost:8080
